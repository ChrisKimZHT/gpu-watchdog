{
  "interval_seconds": 30,
  "cooldown_seconds": 300,
  "log_level": "INFO",
  "notifiers": {
    "bark": {
      "enabled": false,
      "server": "https://api.day.app",
      "device_key": "REPLACE_WITH_YOUR_BARK_KEY",
      "isArchive": "1",
      "icon": "https://example.com/icon.png",
      "group": "gpu-watchdog",
      "sound": "alarm",
      "level": "active"
    }
  },
  "rules": [
    {
      "id": "cpu-pressure-high",
      "type": "cpu",
      "notify": true,
      "command": "echo \"$GPU_WATCHDOG_TITLE $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "busy",
        "metric": "some.avg10",
        "threshold": 80
      }
    },
    {
      "id": "mem-high",
      "type": "memory",
      "notify": true,
      "options": {
        "kind": "busy",
        "threshold": 90
      }
    },
    {
      "id": "root-disk-high",
      "type": "disk",
      "notify": true,
      "options": {
        "kind": "busy",
        "mount": "/",
        "threshold": 90
      }
    },
    {
      "id": "gpu0-memory-idle",
      "type": "gpu",
      "notify": true,
      "command": "echo \"GPU 0 memory is idle\"",
      "options": {
        "kind": "idle",
        "ids": ["0"],
        "mode": "memory",
        "threshold": 5
      }
    },
    {
      "id": "any-gpu-busy",
      "type": "gpu",
      "notify": true,
      "options": {
        "kind": "busy",
        "mode": "both",
        "match": "any",
        "compute_threshold": 95,
        "memory_threshold": 95
      }
    },
    {
      "id": "train-pid-watch",
      "type": "process",
      "notify": true,
      "command": "echo \"training process disappeared\"",
      "options": {
        "name": "training",
        "pids": [12345, 23456]
      }
    }
  ]
}
