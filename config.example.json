{
  "interval_seconds": 30,
  "cooldown_seconds": 300,
  "log_level": "INFO",
  "notifiers": {
    "bark": {
      "enabled": false,
      "server": "https://api.day.app",
      "device_key": "REPLACE_WITH_YOUR_BARK_KEY",
      "timeout_seconds": 10,
      "level": "active",
      "passthrough": {
        "isArchive": "1",
        "icon": "https://example.com/icon.png",
        "group": "gpu-watchdog",
        "sound": "alarm"
      }
    },
    "smtp": {
      "enabled": false,
      "host": "smtp.example.com",
      "port": 587,
      "username": "REPLACE_WITH_SMTP_USERNAME",
      "password": "REPLACE_WITH_SMTP_PASSWORD",
      "from_addr": "watchdog@example.com",
      "to_addrs": ["admin@example.com"],
      "timeout_seconds": 10,
      "ssl": false,
      "starttls": true
    }
  },
  "rules": [
    {
      "id": "cpu-pressure-high",
      "type": "cpu",
      "notify": true,
      "command": "echo \"$GPU_WATCHDOG_TITLE $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "busy",
        "metric": "some.avg10",
        "threshold": 80
      }
    },
    {
      "id": "mem-high",
      "type": "memory",
      "notify": true,
      "pending_period": 60,
      "options": {
        "kind": "busy",
        "threshold": 90
      }
    },
    {
      "id": "root-disk-high",
      "type": "disk",
      "notify": true,
      "options": {
        "kind": "busy",
        "mount": "/",
        "threshold": 90
      }
    },
    {
      "id": "gpu0-memory-idle",
      "type": "gpu",
      "notify": true,
      "command": "echo \"GPU 0 memory is idle\"",
      "options": {
        "kind": "idle",
        "gpus": ["0"],
        "gpu_match": "any",
        "threshold": {
          "memory": 5
        }
      }
    },
    {
      "id": "any-gpu-busy",
      "type": "gpu",
      "notify": true,
      "options": {
        "kind": "busy",
        "gpus": ["0"],
        "gpu_match": "any",
        "threshold_match": "any",
        "threshold": {
          "compute": 95,
          "memory": 95
        }
      }
    },
    {
      "id": "train-pid-watch",
      "type": "process",
      "notify": true,
      "command": "echo \"training process disappeared\"",
      "options": {
        "name": "training",
        "pids": [12345, 23456]
      }
    }
  ]
}
