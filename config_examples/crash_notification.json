{
  "interval_seconds": 10,
  "cooldown_seconds": 300,
  "log_level": "INFO",
  "notifiers": {
    "smtp": {
      "enabled": false,
      "host": "smtp.example.com",
      "port": 587,
      "username": "REPLACE_WITH_SMTP_USERNAME",
      "password": "REPLACE_WITH_SMTP_PASSWORD",
      "from_addr": "watchdog@example.com",
      "to_addrs": [
        "admin@example.com"
      ],
      "timeout_seconds": 10,
      "ssl": true,
      "starttls": false
    }
  },
  "rules": [
    {
      "id": "training-process-missing",
      "type": "process",
      "notify": true,
      "cooldown_seconds": 86400,
      "pending_period": 0,
      "options": {
        "name": "training",
        "pids": [
          12345,
          23456
        ]
      }
    }
  ]
}