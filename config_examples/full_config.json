{
  "interval_seconds": 30,
  "cooldown_seconds": 300,
  "log_level": "INFO",
  "notifiers": {
    "bark": {
      "enabled": false,
      "server": "https://api.day.app",
      "device_key": "REPLACE_WITH_YOUR_BARK_KEY",
      "timeout_seconds": 10,
      "level": "active",
      "passthrough": {
        "group": "gpu-watchdog",
        "isArchive": "1"
      }
    },
    "smtp": {
      "enabled": false,
      "host": "smtp.example.com",
      "port": 587,
      "username": "REPLACE_WITH_SMTP_USERNAME",
      "password": "REPLACE_WITH_SMTP_PASSWORD",
      "from_addr": "watchdog@example.com",
      "to_addrs": [
        "admin@example.com"
      ],
      "timeout_seconds": 10,
      "ssl": true,
      "starttls": false
    }
  },
  "rules": [
    {
      "id": "cpu-pressure-busy",
      "type": "cpu",
      "notify": true,
      "pending_period": 60,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE\"",
      "options": {
        "kind": "busy",
        "metric": "some.avg10",
        "threshold": 80
      }
    },
    {
      "id": "cpu-pressure-idle",
      "type": "cpu",
      "notify": true,
      "pending_period": 300,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE - $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "idle",
        "metric": "some.avg10",
        "threshold": 10
      }
    },
    {
      "id": "memory-busy",
      "type": "memory",
      "notify": true,
      "pending_period": 60,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE - $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "busy",
        "threshold": 90
      }
    },
    {
      "id": "memory-idle",
      "type": "memory",
      "notify": true,
      "pending_period": 300,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE - $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "idle",
        "threshold": 20
      }
    },
    {
      "id": "root-disk-busy",
      "type": "disk",
      "notify": true,
      "pending_period": 60,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE - $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "busy",
        "mount": "/",
        "threshold": 90
      }
    },
    {
      "id": "data-disk-idle",
      "type": "disk",
      "notify": false,
      "pending_period": 300,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE - $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "idle",
        "mount": "/data",
        "threshold": 20
      }
    },
    {
      "id": "any-gpu-busy",
      "type": "gpu",
      "notify": true,
      "pending_period": 60,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE - $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "busy",
        "gpus": [
          "0",
          "1"
        ],
        "gpu_match": "any",
        "threshold_match": "any",
        "threshold": {
          "compute": 95,
          "memory": 95
        }
      }
    },
    {
      "id": "all-gpus-busy",
      "type": "gpu",
      "notify": true,
      "pending_period": 120,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE - $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "busy",
        "gpus": [
          "0",
          "1"
        ],
        "gpu_match": "all",
        "threshold_match": "all",
        "threshold": {
          "compute": 90,
          "memory": 80
        }
      }
    },
    {
      "id": "any-gpu-idle",
      "type": "gpu",
      "notify": true,
      "pending_period": 300,
      "command": [
        "sh",
        "-c",
        "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE\""
      ],
      "options": {
        "kind": "idle",
        "gpus": [
          "0",
          "1"
        ],
        "gpu_match": "any",
        "threshold_match": "all",
        "threshold": {
          "compute": 5,
          "memory": 5
        }
      }
    },
    {
      "id": "all-gpus-idle",
      "type": "gpu",
      "notify": true,
      "pending_period": 300,
      "command": "echo \"$GPU_WATCHDOG_KIND $GPU_WATCHDOG_RULE $GPU_WATCHDOG_TITLE - $GPU_WATCHDOG_BODY\"",
      "options": {
        "kind": "idle",
        "gpu_match": "all",
        "threshold_match": "any",
        "threshold": {
          "compute": 5
        }
      }
    },
    {
      "id": "training-process-missing",
      "type": "process",
      "notify": true,
      "pending_period": 0,
      "command": "echo \"$GPU_WATCHDOG_BODY\"",
      "options": {
        "name": "training",
        "pids": [
          12345,
          23456
        ]
      }
    }
  ]
}
