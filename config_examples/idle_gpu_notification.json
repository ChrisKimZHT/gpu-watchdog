{
  "interval_seconds": 10,
  "cooldown_seconds": 300,
  "log_level": "INFO",
  "notifiers": {
    "smtp": {
      "enabled": false,
      "host": "smtp.example.com",
      "port": 587,
      "username": "REPLACE_WITH_SMTP_USERNAME",
      "password": "REPLACE_WITH_SMTP_PASSWORD",
      "from_addr": "watchdog@example.com",
      "to_addrs": [
        "admin@example.com"
      ],
      "timeout_seconds": 10,
      "ssl": true,
      "starttls": false
    }
  },
  "rules": [
    {
      "id": "any-gpu-idle",
      "type": "gpu",
      "notify": true,
      "cooldown_seconds": 3600,
      "pending_period": 300,
      "options": {
        "kind": "idle",
        "gpu_match": "any",
        "threshold": {
          "memory": 20
        }
      }
    }
  ]
}