{
  "interval_seconds": 10,
  "cooldown_seconds": 300,
  "log_level": "INFO",
  "notifiers": {
    "smtp": {
      "enabled": false,
      "host": "smtp.example.com",
      "port": 587,
      "username": "REPLACE_WITH_SMTP_USERNAME",
      "password": "REPLACE_WITH_SMTP_PASSWORD",
      "from_addr": "watchdog@example.com",
      "to_addrs": [
        "admin@example.com"
      ],
      "timeout_seconds": 10,
      "ssl": true,
      "starttls": false
    }
  },
  "rules": [
    {
      "id": "any-gpu-idle",
      "type": "gpu",
      "notify": true,
      "cooldown_seconds": 8640000,
      "pending_period": 10,
      "options": {
        "kind": "idle",
        "idle_count": "2",
        "threshold": {
          "memory": 20
        }
      },
      "command": {
        "command": [
          "CUDA_VISIBLE_DEVICES=$GPU_WATCHDOG_EXTRAENV_PREFER_MEMORY_GPUS",
          "~/anaconda3/envs/pytorch/bin/python",
          "-u",
          "-m torch.distributed.run",
          "--nproc_per_node=2",
          "~/gpu-watchdog/tests/stress_gpu.py",
          "--compute",
          "--percent $MYENV_PERCENT",
          "--duration $MYENV_DURATION"
        ],
        "env": {
          "MYENV_PERCENT": "50",
          "MYENV_DURATION": "10"
        },
        "stdout": "~/gpu-watchdog/tests/stdout.log",
        "stderr": "~/gpu-watchdog/tests/stderr.log",
        "cwd": "~/gpu-watchdog/tests",
        "start_new_session": true
      }
    }
  ]
}